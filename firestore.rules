rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.get('role', 'user');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() &&
        getUserRole() in ['admin', 'super_admin'];
    }

    function isWriter() {
      return isAuthenticated() &&
        getUserRole() in ['writer', 'admin', 'super_admin'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The site owner's verified account becomes super_admin automatically.
    // Keep in sync with OWNER_EMAIL in src/data/site.ts.
    function isSiteOwner() {
      return isAuthenticated() &&
        request.auth.token.email == 'chidera9713@gmail.com';
    }

    function isValidRole(role) {
      return role in [
        'reader',
        'user',
        'writer',
        'admin',
        'super_admin'
      ];
    }

    function isValidPostStatus(status) {
      return status in ['draft', 'pending', 'approved', 'rejected'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isSignedIn() &&
        request.auth.uid == userId && (
          request.resource.data.get('role', 'user') == 'user' ||
          (isSiteOwner() && request.resource.data.get('role', 'user') == 'super_admin')
        );

      allow update: if (
        isOwner(userId) &&
        isSiteOwner() &&
        request.resource.data.get('role', 'user') == 'super_admin' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
      ) || (
        isSuperAdmin() &&
        isValidRole(request.resource.data.get('role', 'user')) &&
        (
          request.auth.uid != userId ||
          request.resource.data.get('role', 'user') == 'super_admin'
        )
      ) || (
        isAdmin() &&
        resource.data.get('role', 'user') != 'admin' &&
        resource.data.get('role', 'user') != 'super_admin' &&
        isValidRole(request.resource.data.get('role', 'user')) &&
        request.resource.data.get('role', 'user') != 'admin' &&
        request.resource.data.get('role', 'user') != 'super_admin'
      ) || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'nickname',
          'photoURL',
          'bookmarks',
          'updatedAt'
        ]) &&
        request.resource.data.get('bookmarks', []) is list &&
        request.resource.data.get('bookmarks', []).size() <= 500
      );

      allow delete: if (
        isSuperAdmin() && request.auth.uid != userId
      ) || (
        isAdmin() &&
        resource.data.get('role', 'user') != 'admin' &&
        resource.data.get('role', 'user') != 'super_admin'
      ) || (
        isOwner(userId) &&
        resource.data.get('role', 'user') != 'admin' &&
        resource.data.get('role', 'user') != 'super_admin'
      );
    }

    match /posts/{postId} {
      function isPostOwner() {
        return isAuthenticated() &&
          resource.data.authorId == request.auth.uid;
      }

      function isValidPostCreate() {
        return request.resource.data.keys().hasAll([
          'title',
          'content',
          'authorId',
          'authorName',
          'createdAt',
          'status'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.authorId == request.auth.uid &&
        isValidPostStatus(request.resource.data.status) &&
        request.resource.data.get('likedBy', []) is list &&
        request.resource.data.get('likes', 0) is int;
      }

      function isWriterPostUpdate() {
        return isWriter() &&
          isPostOwner() &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.status in ['draft', 'pending', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'content',
            'excerpt',
            'coverImage',
            'status',
            'category',
            'tags',
            'readingTime',
            'technicalStack',
            'scheduledFor',
            'coverImageAlt',
            'seoTitle',
            'seoDescription',
            'series',
            'seriesOrder',
            'lastEditedBy',
            'previewToken',
            'updatedAt'
          ]);
      }

      function isLikeUpdate() {
        let before = resource.data.get('likedBy', []);
        let after = request.resource.data.get('likedBy', []);
        let added = after.toSet().difference(before.toSet());
        let removed = before.toSet().difference(after.toSet());
        return isAuthenticated() &&
          before is list &&
          after is list &&
          after.size() == after.toSet().size() &&
          added.hasOnly([request.auth.uid]) &&
          removed.hasOnly([request.auth.uid]) &&
          added.size() + removed.size() == 1 &&
          request.resource.data.likes == after.size() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likedBy',
            'likes',
            'updatedAt'
          ]);
      }

      function isViewUpdate() {
        return request.resource.data.get('views', 0) is int &&
          request.resource.data.get('views', 0) ==
            resource.data.get('views', 0) + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
      }

      allow read: if resource.data.status == 'approved' ||
        isAdmin() ||
        isPostOwner();

      allow create: if isAuthenticated() &&
        isValidPostCreate() &&
        (
          isAdmin() ||
          (
            isWriter() &&
            request.resource.data.status in ['draft', 'pending']
          )
        );

      allow update: if isAdmin() ||
        isWriterPostUpdate() ||
        isLikeUpdate() ||
        isViewUpdate();

      allow delete: if isAdmin() || (isWriter() && isPostOwner());

      // Saved versions of a post, visible to its author and administrators.
      match /revisions/{revisionId} {
        function canEditParent() {
          return isAdmin() || (
            isWriter() &&
            get(/databases/$(database)/documents/posts/$(postId)).data.authorId ==
              request.auth.uid
          );
        }

        allow read: if canEditParent();
        allow create: if canEditParent() &&
          request.resource.data.savedBy == request.auth.uid &&
          request.resource.data.title is string &&
          request.resource.data.content is string &&
          request.resource.data.content.size() < 900000;
        allow delete: if isAdmin();
      }
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        getUserRole() != 'reader' &&
        request.resource.data.keys().hasOnly([
          'postId', 'authorId', 'authorName', 'authorAvatar', 'content', 'parentId', 'createdAt'
        ]) &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.postId.size() <= 128 &&
        request.resource.data.authorName is string &&
        request.resource.data.authorName.size() <= 100 &&
        (request.resource.data.get('authorAvatar', null) == null ||
          (request.resource.data.authorAvatar is string && request.resource.data.authorAvatar.size() <= 2048)) &&
        (request.resource.data.get('parentId', null) == null ||
          (request.resource.data.parentId is string && request.resource.data.parentId.size() <= 128)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500;

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content',
          'updatedAt'
        ]) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.authorId == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      function isReadByUpdate() {
        let before = resource.data.get('readBy', []);
        let after = request.resource.data.get('readBy', []);
        return after is list &&
          after.toSet().hasAll(before.toSet()) &&
          after.toSet().difference(before.toSet()).hasOnly([request.auth.uid]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
      }

      // userId is a user's uid, 'all' (every verified user) or 'admins'.
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all'
      );

      allow create: if isAdmin() || (
        isWriter() &&
        request.resource.data.userId == 'admins' &&
        request.resource.data.type == 'pending_post'
      ) || (
        isAuthenticated() &&
        request.resource.data.type == 'comment' &&
        request.resource.data.userId is string &&
        request.resource.data.userId != request.auth.uid &&
        request.resource.data.userId != 'all' &&
        request.resource.data.userId != 'admins'
      );

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        ) ||
        (
          resource.data.userId in ['all', 'admins'] && isReadByUpdate()
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
    }

    // Portfolio projects shown on the home page.
    match /projects/{projectId} {
      function optionalString(field, max) {
        return request.resource.data.get(field, null) == null ||
          (request.resource.data[field] is string && request.resource.data[field].size() <= max);
      }

      function isValidProject() {
        let data = request.resource.data;
        return data.keys().hasOnly([
            'title', 'slug', 'summary', 'description', 'imageUrl', 'liveUrl', 'repoUrl',
            'tech', 'role', 'order', 'createdAt', 'updatedAt'
          ]) &&
          data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
          data.slug is string && data.slug.size() > 0 && data.slug.size() <= 120 &&
          data.summary is string && data.summary.size() > 0 && data.summary.size() <= 400 &&
          optionalString('description', 8000) &&
          optionalString('imageUrl', 2048) &&
          optionalString('liveUrl', 2048) &&
          optionalString('repoUrl', 2048) &&
          optionalString('role', 200) &&
          data.get('tech', []) is list && data.get('tech', []).size() <= 20 &&
          (data.get('order', 0) is int || data.get('order', 0) is float);
      }

      allow read: if true;
      allow create, update: if isAdmin() && isValidProject();
      allow delete: if isAdmin();
    }

    // Daily view totals written as readers open posts; read by admins.
    match /dailyStats/{day} {
      function isViewIncrement() {
        let before = resource == null ? 0 : resource.data.get('views', 0);
        let postsBefore = resource == null ? {} : resource.data.get('posts', {});
        let postsAfter = request.resource.data.get('posts', {});
        return request.resource.data.date == day &&
          request.resource.data.views == before + 1 &&
          postsAfter is map &&
          postsAfter.size() <= 2000 &&
          postsAfter.diff(postsBefore).affectedKeys().size() <= 1 &&
          postsAfter.diff(postsBefore).removedKeys().size() == 0 &&
          request.resource.data.keys().hasOnly(['date', 'views', 'posts']);
      }

      allow read: if isAdmin();
      allow create, update: if isViewIncrement();
      allow delete: if isAdmin();
    }

    // Newsletter subscribers are written by the email API (Admin SDK).
    match /subscribers/{subscriberId} {
      allow read, delete: if isAdmin();
      allow create, update: if false;
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'message',
        'createdAt',
        'read'
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() >= 3 &&
      request.resource.data.name.size() <= 100 &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.email.matches(
        '^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'
      ) &&
      request.resource.data.message is string &&
      request.resource.data.message.size() >= 10 &&
      request.resource.data.message.size() <= 5000 &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.read == false;

      allow read, update, delete: if isAdmin();
    }
  }
}
