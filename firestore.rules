rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function getUserRole() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.get('role', 'user');
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserRole() == 'super_admin';
    }

    function isAdmin() {
      return isAuthenticated() &&
        getUserRole() in ['admin', 'super_admin'];
    }

    function isWriter() {
      return isAuthenticated() &&
        getUserRole() in ['writer', 'admin', 'super_admin'];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidRole(role) {
      return role in [
        'reader',
        'user',
        'writer',
        'admin',
        'super_admin'
      ];
    }

    function isValidPostStatus(status) {
      return status in ['draft', 'pending', 'approved', 'rejected'];
    }

    match /users/{userId} {
      allow read: if isAdmin() || isOwner(userId);

      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.get('role', 'user') == 'user';

      allow update: if (
        isSuperAdmin() &&
        isValidRole(request.resource.data.get('role', 'user')) &&
        (
          request.auth.uid != userId ||
          request.resource.data.get('role', 'user') == 'super_admin'
        )
      ) || (
        isAdmin() &&
        resource.data.get('role', 'user') != 'admin' &&
        resource.data.get('role', 'user') != 'super_admin' &&
        isValidRole(request.resource.data.get('role', 'user')) &&
        request.resource.data.get('role', 'user') != 'admin' &&
        request.resource.data.get('role', 'user') != 'super_admin'
      ) || (
        isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'nickname',
          'photoURL',
          'updatedAt'
        ])
      );

      allow delete: if (
        isSuperAdmin() && request.auth.uid != userId
      ) || (
        isAdmin() &&
        resource.data.get('role', 'user') != 'admin' &&
        resource.data.get('role', 'user') != 'super_admin'
      ) || (
        isOwner(userId) &&
        resource.data.get('role', 'user') != 'admin' &&
        resource.data.get('role', 'user') != 'super_admin'
      );
    }

    match /posts/{postId} {
      function isPostOwner() {
        return isAuthenticated() &&
          resource.data.authorId == request.auth.uid;
      }

      function isValidPostCreate() {
        return request.resource.data.keys().hasAll([
          'title',
          'content',
          'authorId',
          'authorName',
          'createdAt',
          'status'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.authorId == request.auth.uid &&
        isValidPostStatus(request.resource.data.status) &&
        request.resource.data.get('likedBy', []) is list &&
        request.resource.data.get('likes', 0) is int;
      }

      function isWriterPostUpdate() {
        return isWriter() &&
          isPostOwner() &&
          request.resource.data.authorId == resource.data.authorId &&
          request.resource.data.status in ['draft', 'pending', 'rejected'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title',
            'content',
            'excerpt',
            'coverImage',
            'status',
            'category',
            'tags',
            'readingTime',
            'technicalStack',
            'scheduledFor',
            'updatedAt'
          ]);
      }

      function isLikeUpdate() {
        let before = resource.data.get('likedBy', []);
        let after = request.resource.data.get('likedBy', []);
        let added = after.toSet().difference(before.toSet());
        let removed = before.toSet().difference(after.toSet());
        return isAuthenticated() &&
          before is list &&
          after is list &&
          after.size() == after.toSet().size() &&
          added.hasOnly([request.auth.uid]) &&
          removed.hasOnly([request.auth.uid]) &&
          added.size() + removed.size() == 1 &&
          request.resource.data.likes == after.size() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'likedBy',
            'likes',
            'updatedAt'
          ]);
      }

      function isViewUpdate() {
        return request.resource.data.get('views', 0) is int &&
          request.resource.data.get('views', 0) ==
            resource.data.get('views', 0) + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'views',
            'updatedAt'
          ]);
      }

      allow read: if resource.data.status == 'approved' ||
        isAdmin() ||
        isPostOwner();

      allow create: if isAuthenticated() &&
        isValidPostCreate() &&
        (
          isAdmin() ||
          (
            isWriter() &&
            request.resource.data.status in ['draft', 'pending']
          )
        );

      allow update: if isAdmin() ||
        isWriterPostUpdate() ||
        isLikeUpdate() ||
        isViewUpdate();

      allow delete: if isAdmin() || (isWriter() && isPostOwner());
    }

    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /comments/{commentId} {
      allow read: if true;

      allow create: if isAuthenticated() &&
        getUserRole() != 'reader' &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.postId is string &&
        request.resource.data.authorName is string &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500;

      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.authorId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'content',
          'updatedAt'
        ]) &&
        request.resource.data.content is string &&
        request.resource.data.content.size() > 0 &&
        request.resource.data.content.size() <= 500
      );

      allow delete: if isAdmin() || (
        isAuthenticated() && resource.data.authorId == request.auth.uid
      );
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.userId == request.auth.uid ||
        resource.data.userId == 'all'
      );

      allow create: if isAdmin();

      allow update, delete: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
    }

    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name',
        'email',
        'message',
        'createdAt',
        'read'
      ]) &&
      request.resource.data.name is string &&
      request.resource.data.name.size() >= 3 &&
      request.resource.data.name.size() <= 100 &&
      request.resource.data.email is string &&
      request.resource.data.email.size() <= 254 &&
      request.resource.data.email.matches(
        '^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'
      ) &&
      request.resource.data.message is string &&
      request.resource.data.message.size() >= 10 &&
      request.resource.data.message.size() <= 5000 &&
      request.resource.data.createdAt == request.time &&
      request.resource.data.read == false;

      allow read, update, delete: if isAdmin();
    }
  }
}
