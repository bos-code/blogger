# ---------------------------------------------------------------------------
# Browser (Vite) — embedded in the client bundle. Firebase web config is
# designed to be public; access is enforced by firestore.rules/storage.rules.
# ---------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abc123

# Optional: AI title/excerpt suggestions in the editor (hidden when unset).
# This token is visible in the browser — use a narrowly scoped one.
# VITE_HUGGINGFACE_API_KEY=
# VITE_HUGGINGFACE_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Optional: production error monitoring.
# VITE_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Server (Vercel functions in /api) — set these in Vercel → Settings →
# Environment Variables. Never prefix them with VITE_.
# ---------------------------------------------------------------------------
# Public site URL used in emails, RSS and the sitemap.
# SITE_URL=https://your-site.vercel.app
# Gmail account that sends email, and its 16-character app password.
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcdefghijklmnop
# Where owner alerts go (defaults to GMAIL_USER).
# ALERT_EMAIL=you@gmail.com
# Firebase service account JSON (one line) for the Admin SDK.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","client_email":"...","private_key":"..."}
